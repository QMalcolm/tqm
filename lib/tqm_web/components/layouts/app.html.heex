<nav class="qm-nav">
  <a href="/" class="qm-brand">quigley<span class="qm-brand-dot">.</span></a>
  <div class="qm-navlinks">
    <.link navigate="/" class={if assigns[:tlp] == :home, do: "active", else: ""}>Home</.link>
    <.link navigate="/blog" class={if assigns[:tlp] == :blog, do: "active", else: ""}>
      Writing
    </.link>
    <.link navigate="/about" class={if assigns[:tlp] == :about, do: "active", else: ""}>
      About
    </.link>
    <%= if @current_person do %>
      <.link href="/people/log_out" method="delete" class="qm-logout">Log out</.link>
    <% end %>
  </div>
</nav>

<main>
  <.flash kind={:info} title="Success!" flash={@flash} />
  <.flash kind={:error} title="Error!" flash={@flash} />
  <.flash
    id="disconnected"
    kind={:error}
    title="We can't find the internet"
    close={false}
    autoshow={false}
    phx-disconnected={show("#disconnected")}
    phx-connected={hide("#disconnected")}
  >
    Attempting to reconnect <Heroicons.arrow_path class="ml-1 w-3 h-3 inline animate-spin" />
  </.flash>
  {@inner_content}
</main>

<footer class="qm-foot">
  <span>© Quigley Malcolm · Iowa City, IA</span>
  <span>
    <a href="https://github.com/QMalcolm">GitHub</a>
    <a href="https://www.linkedin.com/in/quigley-malcolm/">LinkedIn</a>
    <.link navigate={~p"/blog/feed.xml"}>RSS</.link>
  </span>
</footer>
