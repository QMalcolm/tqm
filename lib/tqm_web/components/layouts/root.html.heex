<!DOCTYPE html>
<html lang="en" style="scrollbar-gutter: stable;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />
    <.live_title prefix={if assigns[:page_title], do: "QM: ", else: ""}>
      {assigns[:page_title] || "Quigley Malcolm"}
    </.live_title>
    <link rel="icon" type="image/png" href={~p"/favicon.png"} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Quigley Malcolm"
      href={~p"/blog/feed.xml"}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body style="background: var(--bg); color: var(--ink); font-family: var(--sans);" class="antialiased">
    {@inner_content}
  </body>
</html>
