<article class="qm-page-narrow" style="padding-top: 56px;">
  <.link
    navigate={~p"/blog"}
    style="font-family: var(--mono); font-size: 12px; color: var(--muted); text-decoration: none; letter-spacing: 0.05em;"
  >
    ← all writing
  </.link>

  <div style="display: flex; gap: 14px; align-items: center; margin: 28px 0 18px; font-family: var(--mono); font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; flex-wrap: wrap;">
    <%= if @blog_post.published_at do %>
      <span>{Calendar.strftime(@blog_post.published_at, "%b %-d, %Y")}</span>
      <span class="qm-meta-dot"></span>
    <% end %>
    <span>{reading_time(@blog_post.content)}</span>
    <%= if @blog_post.tags != [] do %>
      <span class="qm-meta-dot"></span>
      <%= for tag <- @blog_post.tags do %>
        <.link
          navigate={~p"/blog/tags/#{tag.slug}"}
          class="qm-tag"
          style="margin: 0; text-transform: none; letter-spacing: 0;"
        >
          {tag.name}
        </.link>
      <% end %>
    <% end %>
  </div>

  <h1 class="qm-h1" style="font-size: 60px; margin-bottom: 32px;">{@blog_post.title}</h1>

  <%= if @blog_post.foreword do %>
    <aside style="margin-bottom: 48px; padding: 20px 24px; border-radius: 10px; background: var(--bg-alt); border: 1px solid var(--line-2);">
      <p style="margin: 0 0 10px; font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted);">
        Foreword
      </p>
      <div class="qm-post-body" style="font-style: italic; color: var(--ink-2);">
        {@blog_post.foreword |> Earmark.as_html!(footnotes: true) |> Phoenix.HTML.raw()}
      </div>
    </aside>
  <% end %>

  <div class="qm-post-body">
    {@blog_post.content |> Earmark.as_html!(footnotes: true) |> Phoenix.HTML.raw()}
  </div>

  <div style="margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center;">
    <.link
      navigate={~p"/blog"}
      style="font-family: var(--mono); font-size: 12px; color: var(--muted); text-decoration: none; letter-spacing: 0.05em;"
    >
      ← all writing
    </.link>
    <%= if Tqm.Accounts.Person.owner?(assigns[:current_person]) do %>
      <.link
        navigate={~p"/blog/#{@blog_post}/edit"}
        style="font-size: 13px; color: var(--muted); text-decoration: none; border: 1px solid var(--line-2); padding: 8px 14px; border-radius: 999px;"
      >
        Edit post
      </.link>
    <% end %>
  </div>
</article>
