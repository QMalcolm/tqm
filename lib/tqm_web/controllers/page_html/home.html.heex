<div class="qm-page" style="padding-top: 80px;">
  <div class="qm-hero-grid" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 80px; align-items: start;">
    <div>
      <p class="qm-eyebrow">Iowa City, IA · Software Engineer</p>
      <h1 class="qm-h1">
        Hi, I'm <em>Quigley</em>.<br/>
        Amateur at life,<br/>
        real human person.
      </h1>
      <p class="qm-body" style="max-width: 52ch; font-size: 19px;">
        Just trying to do my best, the goal is to do better than yesterday.
        If you want to learn more about me, head to my
        <.link navigate="/about" class="qm-prose-link">about page</.link>. Also if
        you are so inclined, feel free to peruse
        <.link navigate="/blog" class="qm-prose-link">what I've been thinking about</.link> lately.
      </p>
    </div>
    <div>
      <img
        src="images/me.jpg"
        alt="Quigley in a chair working on a laptop."
        style="width: 100%; border-radius: 6px; display: block; box-shadow: 0 1px 0 rgba(0,0,0,.04), 0 18px 40px -20px rgba(0,0,0,.25);"
      />
    </div>
  </div>

  <hr class="qm-rule" />

  <section>
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 28px;">
      <h2 class="qm-h2">Recent writing</h2>
      <.link navigate="/blog" style="font-size: 14px; color: var(--muted); text-decoration: none;">All posts →</.link>
    </div>
    <ul style="list-style: none; padding: 0; margin: 0;">
      <%= for post <- @recent_posts do %>
        <li>
          <.link navigate={~p"/blog/#{post}"} class="qm-post-row">
            <span class="qm-post-row-date">
              <%= if post.published_at do %>
                {Calendar.strftime(post.published_at, "%b %-d, %Y")}
              <% end %>
            </span>
            <span class="qm-post-row-title">{post.title}</span>
            <span>
              <%= for tag <- post.tags do %>
                <span class="qm-tag">{tag.name}</span>
              <% end %>
            </span>
          </.link>
        </li>
      <% end %>
    </ul>
  </section>
</div>
