<div class="qm-page" style="padding-top: 64px;">
  <div
    class="qm-about-grid"
    style="display: grid; grid-template-columns: 1fr 280px; gap: 64px; align-items: start;"
  >
    <div>
      <p class="qm-eyebrow">About</p>
      <p class="qm-lede" style="max-width: 22ch;">
        Hello! Not sure what brought you here, but welcome to the party :)
      </p>
      <div class="qm-body" style="max-width: 58ch;">
        <p>
          My name is <strong style="color: var(--ink); font-weight: 500;">Thomas Quigley Malcolm</strong>, but I generally go by Quigley (also Quig, Quigs, Quigglez, Squigglez; you get the jist).
          I grew up in a small town in Northern Wisconsin, currently live in Iowa City, and I long to return to PNW.
        </p>
        <p>
          Professionally I'm currently a Open Source Software Engineer. I enjoy building software that solves problems others experience, and have been doing so for a bit over a decade.
          Also, I used to be an ice cream maker. Did so for seven years. I've now been not an ice cream maker for longer than I ever was one, but still day dream about making it and
          caring for the machines.
        </p>
        <p>
          Non-professionally I do a great many other things, with varying degrees of seriousness and aptitude.
          I like to run, bike, read, and cuddle my cat sons. I play TTRPGs like D&D, and still consider myself a GM even though
          I haven't personally GM'd a game in 4 years. I have a nice camera, but take less photos than I'd like. Oh and I like
          play board games, a lot.
        </p>
        <p>
          If you're trying to track me down in Iowa City, I can probably be found working in
          <a href="https://mergeic.com/" class="qm-prose-link">MERGE</a>
          coworking space or meandering through <a
            href="https://en.wikipedia.org/wiki/Hickory_Hill_Park"
            class="qm-prose-link"
          >Hickory Hill Park</a>.
        </p>
      </div>
    </div>
    <div>
      <img
        src="images/me_old_1.jpg"
        alt="Quigley reading on a chair"
        style="width: 100%; border-radius: 6px; display: block;"
      />
    </div>
  </div>

  <hr class="qm-rule" />

  <section>
    <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 32px;">
      <h2 class="qm-h2">Work, in order</h2>
      <span style="font-family: var(--mono); font-size: 12px; color: var(--muted);">
        <%= if Tqm.Accounts.Person.owner?(assigns[:current_person]) do %>
          <.link
            navigate={~p"/about/jobs/new"}
            style="color: var(--accent); text-decoration: none;"
          >
            + add job
          </.link>
          ·
        <% end %>
        {length(@jobs)} positions
      </span>
    </div>
    <ol style="list-style: none; padding: 0; margin: 0;">
      <%= for job <- @jobs do %>
        <li
          id={"job-#{job.id}"}
          class="qm-job-row"
          phx-click="toggle_job"
          phx-value-id={job.id}
          style="cursor: pointer;"
        >
          <span style="font-family: var(--mono); font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; padding-top: 6px;">
            {job_year_range(job)}
          </span>
          <span class="qm-job-dot" style={"background: #{job_color(job)}"}></span>
          <div>
            <div style="font-family: var(--serif); font-size: 24px; line-height: 1.2; color: var(--ink);">
              {job.company_name}
            </div>
            <div style="font-size: 14px; color: var(--muted); margin-top: 2px;">
              {current_role_title(job)}
            </div>
          </div>
          <span style="color: var(--muted); font-size: 18px; line-height: 1; padding-top: 8px; text-align: right;">
            {if MapSet.member?(@expanded_jobs, job.id), do: "–", else: "+"}
          </span>
        </li>
        <%= if MapSet.member?(@expanded_jobs, job.id) do %>
          <li style="padding: 0 0 20px; border-top: none;">
            <div style="padding-left: 196px;">
              <%= if Tqm.Accounts.Person.owner?(assigns[:current_person]) do %>
                <div style="margin-bottom: 12px;">
                  <.link
                    navigate={~p"/about/jobs/#{job.id}/edit"}
                    style="font-family: var(--mono); font-size: 12px; color: var(--accent); text-decoration: none; letter-spacing: 0.05em;"
                  >
                    edit job →
                  </.link>
                </div>
              <% end %>
              <%= if job.description do %>
                <div
                  class="qm-job-description"
                  style="font-size: 15px; line-height: 1.6; color: var(--muted); margin: 0 0 16px; max-width: 62ch;"
                >
                  {job.description |> Earmark.as_html!() |> Phoenix.HTML.raw()}
                </div>
              <% end %>
              <%= for role <- job.roles do %>
                <div style="margin-bottom: 12px;">
                  <span style="font-family: var(--sans); font-size: 14px; font-weight: 500; color: var(--ink);">
                    {role.title}
                  </span>
                  <span style="font-family: var(--mono); font-size: 11px; color: var(--muted); margin-left: 8px;">
                    {Calendar.strftime(role.start_date, "%b %Y")} – {if role.end_date,
                      do: Calendar.strftime(role.end_date, "%b %Y"),
                      else: "Present"}
                  </span>
                  <%= if role.details do %>
                    <div
                      class="qm-job-description"
                      style="font-size: 15px; line-height: 1.6; color: var(--ink-2); margin: 6px 0 0; max-width: 62ch;"
                    >
                      {role.details |> Earmark.as_html!() |> Phoenix.HTML.raw()}
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </li>
        <% end %>
      <% end %>
    </ol>
  </section>
</div>
