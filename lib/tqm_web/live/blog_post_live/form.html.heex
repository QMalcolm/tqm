<div style="max-width: 980px; margin: 0 auto; padding: 48px 64px 96px;">
  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;">
    <.link
      navigate={~p"/blog"}
      style="font-family: var(--mono); font-size: 12px; color: var(--muted); text-decoration: none; letter-spacing: 0.05em;"
    >
      ← all writing
    </.link>
    <span
      :if={@live_action == :edit}
      style={"display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 999px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; #{status_style(@publish_status)}"}
    >
      <span style={"width: 6px; height: 6px; border-radius: 999px; background: #{status_dot_color(@publish_status)}; flex-shrink: 0;"}>
      </span>
      {status_label(@publish_status)}
    </span>
  </div>
  <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 8px; gap: 24px;">
    <h1 class="qm-h1" style="font-size: 48px; margin: 0;">
      <%= if @live_action == :new do %>
        New <em>post</em>
      <% else %>
        <%= case @publish_status do %>
          <% :draft -> %>
            Editing a <em>draft</em>
          <% :scheduled -> %>
            Editing a <em>scheduled</em> post
          <% :published -> %>
            Editing a <em>published</em> post
        <% end %>
      <% end %>
    </h1>
  </div>

  <%= if @live_action == :edit do %>
    <p style="font-family: var(--mono); font-size: 12px; color: var(--muted); letter-spacing: 0.04em; margin: 0 0 36px;">
      /blog/{Ecto.Changeset.get_field(@changeset, :slug) || ""}/edit
    </p>
  <% else %>
    <div style="margin-bottom: 36px;"></div>
  <% end %>
  <div
    :if={@changeset.action && not @changeset.valid?}
    style="margin-bottom: 24px; padding: 12px 16px; border-radius: 10px; background: var(--accent-soft); color: var(--accent); font-family: var(--sans); font-size: 14px;"
  >
    Please fix the errors below before saving.
  </div>

  <form id="blog_post_form" phx-change="validate" phx-submit="save">
    <div style="margin-bottom: 32px;">
      <label
        for="blog_post_form_title"
        style="display: block; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin-bottom: 10px;"
      >
        Title
      </label>
      <input
        type="text"
        id="blog_post_form_title"
        name="blog_post[title]"
        value={Ecto.Changeset.get_field(@changeset, :title) || ""}
        style="width: 100%; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--line-2); background: transparent; font-family: var(--serif); font-size: 26px; color: var(--ink); outline: none; box-sizing: border-box;"
      />
      <%= for msg <- field_errors(@changeset, :title) do %>
        <p style="margin: 6px 0 0; font-family: var(--sans); font-size: 13px; color: var(--accent);">
          {msg}
        </p>
      <% end %>
    </div>
    <div style="margin-bottom: 32px;">
      <label
        for="blog_post_form_slug"
        style="display: block; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin-bottom: 10px;"
      >
        Slug
      </label>
      <div style="display: flex; align-items: center; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line-2);">
        <span style="font-family: var(--mono); font-size: 13px; color: var(--muted); white-space: nowrap; flex-shrink: 0;">
          quigleymalcolm.com /blog/
        </span>
        <%= if @live_action == :edit and @publish_status == :published do %>
          <input
            type="hidden"
            name="blog_post[slug]"
            value={Ecto.Changeset.get_field(@changeset, :slug) || ""}
          />
          <span style="flex: 1; font-family: var(--mono); font-size: 13px; color: var(--muted);">
            {Ecto.Changeset.get_field(@changeset, :slug) || ""}
          </span>
        <% else %>
          <input
            type="text"
            id="blog_post_form_slug"
            name="blog_post[slug]"
            value={Ecto.Changeset.get_field(@changeset, :slug) || ""}
            phx-change={if @live_action == :new, do: "lock_slug"}
            phx-debounce={if @live_action == :new, do: "200"}
            style="flex: 1; min-width: 0; border: none; background: transparent; outline: none; font-family: var(--mono); font-size: 13px; color: var(--ink); padding: 0;"
          />
        <% end %>
      </div>
      <p
        :if={@live_action == :new and not @slug_locked}
        style="margin: 6px 0 0; font-family: var(--mono); font-size: 11px; color: var(--muted);"
      >
        Auto-populated from title
      </p>
      <p
        :if={@live_action == :edit and @publish_status == :published}
        style="margin: 6px 0 0; font-family: var(--mono); font-size: 11px; color: var(--muted);"
      >
        Locked — changing the slug of a live post would break existing links
      </p>
      <%= for msg <- field_errors(@changeset, :slug) do %>
        <p style="margin: 6px 0 0; font-family: var(--sans); font-size: 13px; color: var(--accent);">
          {msg}
        </p>
      <% end %>
    </div>
    <div style="margin-bottom: 32px;">
      <label
        for="blog_post_form_foreword"
        style="display: block; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin-bottom: 10px;"
      >
        Foreword
        <span style="font-weight: 400; text-transform: none; letter-spacing: 0; opacity: 0.6;">
          — optional, rendered before the post body
        </span>
      </label>
      <textarea
        id="blog_post_form_foreword"
        name="blog_post[foreword]"
        rows="4"
        placeholder="Add context about when or why this was written…"
        style="width: 100%; padding: 14px 16px; border-radius: 10px; border: 1px solid var(--line-2); background: transparent; font-family: var(--serif); font-size: 16px; color: var(--ink); outline: none; box-sizing: border-box; resize: vertical; line-height: 1.6;"
      >{Ecto.Changeset.get_field(@changeset, :foreword) || ""}</textarea>
    </div>
    <div style="margin-bottom: 32px;">
      <label style="display: block; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin-bottom: 10px;">
        Content
      </label>
      <div
        id="tiptap-content"
        phx-hook="TiptapEditor"
        phx-update="ignore"
        data-field-name="blog_post[content]"
        data-initial={Ecto.Changeset.get_field(@changeset, :content) || ""}
      >
      </div>
      <%= for msg <- field_errors(@changeset, :content) do %>
        <p style="margin: 6px 0 0; font-family: var(--sans); font-size: 13px; color: var(--accent);">
          {msg}
        </p>
      <% end %>
    </div>
    <div style="margin-bottom: 32px;">
      <label style="display: block; font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--muted); margin-bottom: 10px;">
        Tags
      </label>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--line-2); min-height: 48px; position: relative;">
        <%= for name <- @selected_tag_names do %>
          <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--line-2); font-family: var(--mono); font-size: 12px; color: var(--ink-2);">
            #{name}
            <button
              type="button"
              phx-click="remove_tag"
              phx-value-name={name}
              aria-label={"Remove #{name}"}
              style="color: var(--muted); cursor: pointer; font-size: 14px; line-height: 1; opacity: 0.7; background: none; border: none; padding: 0;"
            >
              ×
            </button>
          </span>
        <% end %>
        <div
          id="tag_search_container"
          phx-hook="TagSearch"
          style="flex: 1; min-width: 200px; position: relative;"
        >
          <input
            type="text"
            name="tag_search"
            value={@tag_search}
            phx-keyup="search_tags"
            phx-debounce="200"
            placeholder="Search or create a tag…"
            autocomplete="off"
            style="width: 100%; border: none; background: transparent; outline: none; font-family: var(--sans); font-size: 14px; color: var(--ink); padding: 4px 0;"
          />
          <ul
            :if={@tag_suggestions != [] or @tag_create_option != nil}
            style="position: absolute; z-index: 10; top: 100%; left: 0; min-width: 200px; margin-top: 4px; border-radius: 8px; border: 1px solid var(--line-2); background: var(--bg); box-shadow: 0 4px 16px rgba(0,0,0,0.08); list-style: none; padding: 4px 0;"
          >
            <li :for={tag <- @tag_suggestions}>
              <button
                type="button"
                phx-click="select_tag"
                phx-value-name={tag.name}
                style="width: 100%; padding: 8px 14px; text-align: left; background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: 14px; color: var(--ink-2);"
              >
                {tag.name}
              </button>
            </li>
            <li :if={@tag_create_option != nil}>
              <button
                type="button"
                phx-click="select_tag"
                phx-value-name={@tag_create_option}
                style="width: 100%; padding: 8px 14px; text-align: left; background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: 14px; color: var(--ink-2);"
              >
                {@tag_create_option} <span style="color: var(--muted);">(create new)</span>
              </button>
            </li>
          </ul>
        </div>
      </div>
      <p style="margin: 8px 0 0; font-family: var(--mono); font-size: 11px; color: var(--muted); letter-spacing: 0.04em;">
        press
        <kbd style="padding: 1px 5px; border: 1px solid var(--line-2); border-radius: 4px;">
          ↵
        </kbd>
        to add ·
        <kbd style="padding: 1px 5px; border: 1px solid var(--line-2); border-radius: 4px;">
          ⌫
        </kbd>
        to remove the last
      </p>
    </div>

    <hr style="border: 0; height: 1px; background: var(--line); margin: 40px 0 28px;" />
    <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
      <button type="submit" class="qm-action-btn-dark">
        <span>Save</span>
        <span class="qm-kbd-hint">⌘S</span>
      </button>

      <%= if @live_action == :edit do %>
        <%= if @publish_status == :published do %>
          <button type="button" phx-click="publish_now" class="qm-action-btn-dark">
            Update post
          </button>
        <% else %>
          <button type="button" phx-click="publish_now" class="qm-action-btn-dark">
            <span>Publish now</span>
            <span class="qm-kbd-hint">⌘↵</span>
          </button>
        <% end %>

        <%= if not @scheduling do %>
          <%= if @publish_status in [:draft, :scheduled] do %>
            <button type="button" phx-click="show_schedule_form" class="qm-action-btn-quiet">
              {if @publish_status == :scheduled, do: "Reschedule", else: "Schedule publishing"}
            </button>
          <% end %>
          <%= if @publish_status == :published do %>
            <button type="button" phx-click="unpublish" class="qm-action-btn-quiet">
              Unpublish
            </button>
          <% end %>
          <span style="flex: 1;"></span>
          <.link
            href={~p"/blog/#{@blog_post}"}
            method="delete"
            data-confirm="Delete this post?"
            class="qm-action-btn-quiet"
            style="color: var(--accent); border-color: var(--accent-soft);"
          >
            Delete post
          </.link>
        <% end %>
      <% end %>
    </div>
  </form>
  <%= if @live_action == :edit and @scheduling do %>
    <form
      phx-submit="schedule"
      style="display: flex; align-items: center; gap: 12px; margin-top: 14px; padding: 8px 12px; border-radius: 10px; background: var(--bg-alt); border: 1px solid var(--line-2); flex-wrap: wrap;"
    >
      <span style="font-family: var(--mono); font-size: 11px; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase;">
        Publish at
      </span>
      <input
        type="datetime-local"
        name="scheduled_at"
        required
        style="padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line-2); background: var(--bg); font-family: var(--mono); font-size: 13px; color: var(--ink); outline: none;"
      />
      <button type="submit" class="qm-action-btn-dark" style="padding: 10px 16px;">
        Confirm
      </button>
      <button type="button" phx-click="hide_schedule_form" class="qm-action-btn-ghost">
        Cancel
      </button>
    </form>
  <% end %>
  <%= if @live_action == :edit do %>
    <div style={"margin-top: 20px; padding: 14px 18px; border-radius: 10px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.05em; display: flex; align-items: center; justify-content: space-between; #{status_style(@publish_status)}"}>
      <span>
        <%= case @publish_status do %>
          <% :draft -> %>
            ● <strong style="font-weight: 500;">DRAFT</strong> — not visible to anyone but you
          <% :scheduled -> %>
            ◷ <strong style="font-weight: 500;">SCHEDULED</strong>
            — goes live {Calendar.strftime(@blog_post.published_at, "%b %-d, %Y at %H:%M UTC")}
          <% :published -> %>
            ✓ <strong style="font-weight: 500;">PUBLISHED</strong>
            — live since {Calendar.strftime(@blog_post.published_at, "%b %-d, %Y")}
        <% end %>
      </span>
      <span style="opacity: 0.7;">
        <%= case @publish_status do %>
          <% :draft -> %>
            created {Calendar.strftime(@blog_post.inserted_at, "%b %-d, %Y")}
          <% :scheduled -> %>
            &nbsp;
          <% :published -> %>
            <.link
              navigate={~p"/blog/#{@blog_post}"}
              style="color: inherit; text-decoration: none;"
            >
              view on site →
            </.link>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
